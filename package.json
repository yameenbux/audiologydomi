{
  "name": "domi",
  "version": "0.1.0",
  "private": true,
  "description": "Domiciliary optician diary with automatic cancellation refill. Demo build.",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-sqlite --no-warnings server/index.js",
    "dev": "node --experimental-sqlite --no-warnings --watch server/index.js",
    "test": "node --experimental-sqlite --no-warnings --require ./test/setup.js --test test/*.test.js",
    "reset": "rm -f data/domi.sqlite*",
    "site": "node scripts/build-site.js _site"
  }
}
